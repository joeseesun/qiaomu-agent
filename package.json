{
  "name": "qiaomu-agent",
  "version": "0.1.0",
  "description": "A calm, native AI agent sidebar for Obsidian.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "ai",
    "agent",
    "mcp",
    "skills"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
